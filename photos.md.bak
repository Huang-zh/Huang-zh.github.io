  </figure>


</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
  <button class="lightbox-close" id="lbClose" aria-label="关闭">×</button>
  <button class="lightbox-prev" id="lbPrev" aria-label="上一张">‹</button>
  <img id="lbImg" alt="">
  <button class="lightbox-next" id="lbNext" aria-label="下一张">›</button>
  <div class="lightbox-info">
    <div class="lightbox-desc" id="lbDesc"></div>
    <div class="lightbox-meta" id="lbMeta"></div>
  </div>
</div>

<script>
(function () {
  var wall = document.getElementById('photosWall');
  var photos = Array.prototype.slice.call(wall.querySelectorAll('.photo'));
  if (!photos.length) return;

  /* ---- 分批滚动加载：每批 12 张，滚动接近时加载下一批 ---- */
  var reduceMotion = window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var noIO = !('IntersectionObserver' in window);
  var BATCH = 12;
  var DELAY = 60;
  var batches = [];
  for (var i = 0; i < photos.length; i += BATCH) {
    batches.push(photos.slice(i, i + BATCH));
  }

  function animateIn(batch) {
    batch.forEach(function (p, idx) {
      p.style.transitionDelay = (idx * DELAY) + 'ms';
      p.classList.add('in');
    });
  }

  if (noIO || reduceMotion) {
    batches.forEach(animateIn);
  } else {
    animateIn(batches[0]);
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var n = parseInt(e.target.getAttribute('data-batch'), 10);
        var batch = batches[n];
        if (batch) {
          batch.forEach(function (p) { p.classList.remove('photo-pending'); });
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { animateIn(batch); });
          });
          e.target.remove();
        }
      });
    }, { rootMargin: '500px 0px', threshold: 0 });
    for (var b = 1; b < batches.length; b++) {
      var s = document.createElement('div');
      s.className = 'ph-sentinel';
      s.setAttribute('data-batch', b);
      batches[b][0].parentNode.insertBefore(s, batches[b][0]);
      batches[b].forEach(function (p) { p.classList.add('photo-pending'); });
      io.observe(s);
    }
  }

  /* ---- Lightbox ---- */
  var lb = document.getElementById('lightbox');
  var lbImg = document.getElementById('lbImg');
  var lbDesc = document.getElementById('lbDesc');
  var lbMeta = document.getElementById('lbMeta');
  var current = -1;

  function show(i) {
    current = (i + photos.length) % photos.length;
    var p = photos[current];
    var img = p.querySelector('img');
    lbImg.src = p.getAttribute('data-full') || img.src;
    lbImg.alt = img.alt || '';
    lbDesc.textContent = p.getAttribute('data-desc') || '';
    var loc = p.getAttribute('data-location');
    var date = p.getAttribute('data-date');
    var meta = [];
    if (loc) meta.push('📍 ' + loc);
    if (date) meta.push('📅 ' + date);
    lbMeta.textContent = meta.join('　');
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function hide() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
  }

  photos.forEach(function (p, i) {
    p.addEventListener('click', function () { show(i); });
  });

  document.getElementById('lbClose').addEventListener('click', hide);
  document.getElementById('lbPrev').addEventListener('click', function (e) {
    e.stopPropagation();
    show(current - 1);
  });
  document.getElementById('lbNext').addEventListener('click', function (e) {
    e.stopPropagation();
    show(current + 1);
  });
  lb.addEventListener('click', function (e) {
    if (e.target === lb) hide();
  });
  document.addEventListener('keydown', function (e) {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') hide();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
})();
</script>
